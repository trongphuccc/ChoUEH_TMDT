<!DOCTYPE html>
<html lang="vi">
<head>
  <title>Quên mật khẩu · Chợ UEH</title>
  <%- include('partials/head') %>
</head>
<body class="bg-background text-on-surface">
<main id="main" class="auth min-h-screen grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
  <%- include('partials/auth-panel', { panelTitle: 'Quên mật khẩu? Chuyện thường ngày mùa thi.', zeenTip: 'Link đặt lại sẽ gửi về đúng email UEH bạn đã đăng ký nhé!' }) %>

  <section class="flex flex-col justify-center px-6 py-12 md:p-16">
    <a href="/" class="cho-ueh-logo md:hidden mb-10 self-center"><div class="logo-emblem"><span class="material-symbols-outlined text-white">school</span></div><div class="logo-wordmark"><span class="logo-cho">Chợ</span><span class="logo-ueh-text">UEH<span class="accent-dot">.</span></span></div></a>
    <div class="max-w-md mx-auto w-full">
      <div class="mb-8">
        <h1 class="font-headline text-4xl font-extrabold text-on-surface tracking-tight mb-2">Đặt lại mật khẩu</h1>
        <p class="text-on-surface-variant">Nhập email UEH hoặc MSSV. Chợ UEH sẽ gửi link đặt mật khẩu mới tới email UEH của tài khoản, có hiệu lực trong 30 phút.</p>
      </div>

      <form id="forgot-form" class="space-y-6" novalidate>
        <div>
          <label class="block text-sm font-semibold text-on-surface-variant mb-2" for="forgot-email">Email UEH hoặc MSSV</label>
          <div class="relative group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors" aria-hidden="true">alternate_email</span>
            <input class="w-full pl-12 pr-4 py-3.5 bg-white rounded-xl outline-none font-medium" id="forgot-email" name="username" placeholder="MSSV hoặc ten@student.ueh.edu.vn" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required/>
          </div>
        </div>
        <div id="forgot-error" class="hidden p-3 bg-red-50 text-red-700 rounded-lg text-sm font-medium" role="alert"></div>
        <button class="btn btn--primary w-full !min-h-[52px] text-base" type="submit" id="forgot-btn">
          Gửi link đặt lại <span class="material-symbols-outlined" aria-hidden="true">send</span>
        </button>
      </form>

      <div id="forgot-done" class="auth-done" hidden role="status">
        <span class="material-symbols-outlined" aria-hidden="true">mark_email_read</span>
        <div>
          <p class="font-headline font-bold text-lg text-on-surface">Kiểm tra hộp thư UEH của bạn</p>
          <p data-done-msg></p>
          <p class="text-sm mt-2">Không thấy email? Xem thư mục Spam/Quảng cáo, hoặc <button type="button" class="font-semibold text-primary underline" data-again>gửi lại</button> sau 1 phút.</p>
        </div>
      </div>

      <div class="mt-10 flex justify-between text-sm">
        <a href="/login" class="text-on-surface-variant hover:text-primary">← Quay lại đăng nhập</a>
        <a href="/register" class="font-semibold text-tertiary hover:underline">Tạo tài khoản mới</a>
      </div>
    </div>
  </section>
</main>

<div id="toast-container" class="toast-container"></div>
<script src="/js/app.js"></script>
<script src="/js/auth.js"></script>
</body>
</html>
