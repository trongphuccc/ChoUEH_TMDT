<%
  const fmt = (n) => (n === undefined || n === null) ? 'Thoả thuận' : new Intl.NumberFormat('vi-VN').format(n) + 'đ';
  const budget = (p) => p.budgetMin && p.budgetMax ? `${fmt(p.budgetMin)} đến ${fmt(p.budgetMax)}`
    : p.budgetMax ? `Tối đa ${fmt(p.budgetMax)}` : p.budgetMin ? `Từ ${fmt(p.budgetMin)}` : 'Linh hoạt';
  const cond = (c) => c === 'new' ? 'Còn mới' : 'Đã dùng';
  // Ask Cloudinary for a right-sized copy instead of the original upload.
  const img = (url, w) => String(url || '').includes('/upload/') ? url.replace('/upload/', `/upload/w_${w},c_limit,f_auto,q_auto/`) : url;
  const places = (p) => [...new Set((p.meetingPoints && p.meetingPoints.length ? p.meetingPoints : [p.location]).map(shortPlace))];
  const urgency = { high: 'Cần gấp', medium: 'Trong tuần này', low: 'Không vội' };
  const txFlag = { negotiating: 'Đang thương lượng', deposited: 'Đã cọc' };
  const hhmm = (c) => c.padStart(5, '0');
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <title>Chợ UEH · Đồ cũ của khoá trên, giá của sinh viên</title>
  <meta name="description" content="Sàn mua bán đồ cũ nội bộ cho sinh viên UEH. Giáo trình, điện tử, đồ dùng. Hẹn nhận đồ ngay tại cơ sở A, B, N." />
  <meta property="og:title" content="Chợ UEH · Đồ cũ của khoá trên, giá của sinh viên" />
  <meta property="og:description" content="Mua bán đồ cũ nội bộ sinh viên UEH. Hẹn nhận đồ ngay trong khuôn viên trường." />
  <meta property="og:image" content="/images/hero/ueh-campus-a-1200.jpg" />
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/vendor/scrollcraft.css" />
  <link rel="stylesheet" href="/css/home.css" />
  <link rel="preload" as="image" href="/images/hero/ueh-campus-a-1200.jpg" imagesrcset="/images/hero/ueh-campus-a-700.jpg 700w, /images/hero/ueh-campus-a-1200.jpg 1200w" imagesizes="(max-width: 860px) 60vw, 34vw" />
</head>
<body class="home">
  <%- include('partials/navbar') %>

  <main id="main">

    <!-- 1 · Hero: khuôn viên UEH thật, nhiều lớp chuyển động khác nhau -->
    <section class="hero" data-sc-act="flow">
      <div class="hero__copy">
        <h1 class="hero__title">Đồ cũ của khoá trên, <em>giá của sinh viên.</em></h1>
        <p class="hero__sub">Sàn mua bán nội bộ chỉ dành cho sinh viên UEH. Hẹn nhận đồ ngay tại cơ sở A, B hoặc N.</p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href="/products">Xem đồ đang bán</a>
          <a class="btn btn--ghost" href="/post-ad">Đăng tin</a>
        </div>
        <% if (stats.activeCount) { %>
          <p class="hero__live"><span class="hero__dot" aria-hidden="true"></span><span><strong class="tabular"><%= stats.activeCount %> món</strong> đang bán, hẹn giao ngay trong trường</span></p>
        <% } %>
        <ul class="hero__trust">
          <li><span class="material-symbols-outlined" aria-hidden="true">verified_user</span>Chỉ tài khoản email UEH</li>
          <li><span class="material-symbols-outlined" aria-hidden="true">savings</span>0đ phí trung gian</li>
          <li><span class="material-symbols-outlined" aria-hidden="true">forum</span>Chat trong web, không lộ số điện thoại</li>
        </ul>
      </div>

      <!-- Campus photos: Tran Trong Nhan, Wikimedia Commons (Campus A: CC BY-SA 1.0; N2, Smart Library: CC0). Credit below the scene. -->
      <div class="hero__scene">
        <div class="hero__plane hero__plane--back" data-sc-parallax="1.6"></div>
        <figure class="hero__side hero__side--0" data-sc-parallax="0.8">
          <img src="/images/hero/ueh-n2.jpg" alt="Sân vườn giảng đường N2, UEH" width="520" height="520" />
          <figcaption>Giảng đường N2</figcaption>
        </figure>
        <figure class="hero__side hero__side--1" data-sc-parallax="1.1">
          <img src="/images/hero/ueh-library.jpg" alt="Smart Library của UEH" width="520" height="520" />
          <figcaption>Smart Library</figcaption>
        </figure>
        <figure class="hero__object" data-sc-parallax="0.2">
          <img src="/images/hero/ueh-campus-a-1200.jpg" srcset="/images/hero/ueh-campus-a-700.jpg 700w, /images/hero/ueh-campus-a-1200.jpg 1200w" sizes="(max-width: 860px) 60vw, 34vw" alt="Cơ sở A của UEH, 59C Nguyễn Đình Chiểu" width="1200" height="900" fetchpriority="high" />
          <figcaption>Cơ sở A · 59C Nguyễn Đình Chiểu</figcaption>
        </figure>
        <% if (hero) { %>
          <div class="hero__front" data-sc-parallax="-0.9">
            <a href="/product/<%= hero._id %>" class="tag hero__tag">
              <span class="tag__kicker">Vừa lên kệ</span>
              <span class="tag__name"><%= hero.title %></span>
              <span class="tag__row tag__row--price"><span class="tag__cond"><%= cond(hero.condition) %></span><strong class="tabular"><%= fmt(hero.price) %></strong></span>
              <span class="tag__row"><span class="material-symbols-outlined" aria-hidden="true">location_on</span><%= places(hero).slice(0, 2).join(', ') %></span>
            </a>
          </div>
        <% } %>
        <img class="hero__zeen" src="/images/zeen-mascot.png" alt="" width="840" height="884" data-sc-parallax="-1.4" />
        <p class="hero__credit">Ảnh: Tran Trong Nhan, Wikimedia Commons (<a href="https://commons.wikimedia.org/wiki/File:Campus_A_of_University_of_Economics_Ho_Chi_Minh_City,_Sep_2022.jpg" target="_blank" rel="noopener">CC BY-SA 1.0</a>, <a href="https://commons.wikimedia.org/wiki/File:UEH_University_Smart_Library.jpg" target="_blank" rel="noopener">CC0</a>)</p>
      </div>
    </section>

    <% if (rail.length > 3) { %>
    <!-- Bảng giá chạy: tin thật vừa lên kệ, như bảng giá ở chợ -->
    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        <% [0, 1].forEach(() => { rail.forEach((p) => { %>
          <span class="ticker__item"><span class="ticker__name"><%= p.title %></span><strong class="tabular"><%= fmt(p.price) %></strong><span class="ticker__place"><%= places(p)[0] %></span></span>
        <% }) }) %>
      </div>
    </div>
    <% } %>

    <!-- 2 · Tìm: một ô tìm kiếm + lọc nhanh theo cơ sở, từ khoá hay tìm, danh mục -->
    <section class="finder" aria-labelledby="finder-title">
      <div class="finder__inner">
        <div class="finder__top">
          <div>
            <h2 id="finder-title" class="finder__title">Bạn đang tìm gì?</h2>
            <p class="finder__sub">Gõ tên món hoặc mã môn, hoặc lọc nhanh theo cơ sở bạn học.</p>
          </div>
          <form class="finder__search" action="/products" method="get" role="search" data-home-search>
            <label class="sr-only" for="home-search">Tìm theo tên hoặc mã môn</label>
            <span class="material-symbols-outlined" aria-hidden="true">search</span>
            <input id="home-search" name="search" type="search" placeholder="Tên món, mã môn (VD: KTVM)…" autocomplete="off" />
            <button type="submit" class="btn btn--primary">Tìm</button>
          </form>
        </div>

        <div class="finder__bar">
          <div class="finder__group" role="group" aria-label="Lọc món mới đăng theo cơ sở">
            <span class="finder__label">Cơ sở</span>
            <button type="button" class="qchip" data-campus="" aria-pressed="true">Tất cả <span class="qchip__n tabular"><%= grid.length %></span></button>
            <% campuses.forEach((c) => { %>
              <button type="button" class="qchip" data-campus="<%= c.name %>" aria-pressed="false"><%= c.name %> <span class="qchip__n tabular"><%= c.count %></span></button>
            <% }) %>
          </div>
          <div class="finder__group">
            <span class="finder__label">Hay tìm</span>
            <% popular.forEach((k) => { %>
              <a class="qchip qchip--key" href="/products?search=<%= encodeURIComponent(k) %>">#<%= k %></a>
            <% }) %>
          </div>
        </div>

        <ul class="index__list">
          <% categories.forEach((c) => { %>
            <li>
              <a href="/products?category=<%= c.slug %>" class="cat<%= c.count ? '' : ' cat--empty' %>">
                <span class="material-symbols-outlined cat__icon" aria-hidden="true"><%= c.icon %></span>
                <span class="cat__label"><%= c.label %></span>
                <span class="cat__count tabular"><%= c.count ? `${c.count} món` : 'Chưa có tin' %></span>
                <span class="material-symbols-outlined cat__go" aria-hidden="true">arrow_forward</span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>

    <% if (grid.length) { %>
    <!-- 3 · Mới đăng: lưới thẻ nhãn giá, lọc theo cơ sở và sắp xếp ngay tại chỗ -->
    <section class="latest" aria-labelledby="latest-title">
      <div class="latest__inner">
        <div class="latest__head">
          <div>
            <h2 id="latest-title" class="latest__title">Mới đăng gần đây</h2>
            <p class="latest__sub" data-latest-note aria-live="polite">Món mới nhất ở cả ba cơ sở.</p>
          </div>
          <div class="latest__tools">
            <div class="seg" role="group" aria-label="Sắp xếp">
              <button type="button" data-sort="new" aria-pressed="true">Mới nhất</button>
              <button type="button" data-sort="asc" aria-pressed="false">Giá thấp</button>
              <button type="button" data-sort="desc" aria-pressed="false">Giá cao</button>
            </div>
            <a class="latest__all" href="/products">Xem tất cả <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <ul class="latest__grid" data-latest>
          <% grid.forEach((p, i) => { %>
            <li data-campus="<%= p.places.join('|') %>" data-price="<%= p.price || 0 %>" data-order="<%= i %>">
              <a href="/product/<%= p._id %>" class="pcard">
                <div class="pcard__photo">
                  <img src="<%= img(p.images[0], 500) %>" alt="<%= p.title %>" width="500" height="500" loading="lazy" />
                  <div class="pcard__flags">
                    <% if (p.isNew) { %><span class="pcard__flag pcard__flag--new">Mới đăng</span><% } %>
                    <% if (txFlag[p.transactionStatus]) { %><span class="pcard__flag pcard__flag--warm"><%= txFlag[p.transactionStatus] %></span><% } %>
                  </div>
                </div>
                <div class="pcard__label">
                  <h3 class="pcard__name"><%= p.title %></h3>
                  <p class="pcard__row"><span class="pcard__price"><%= fmt(p.price) %></span><span class="pcard__cond"><%= cond(p.condition) %></span></p>
                  <p class="pcard__meta"><span><span class="material-symbols-outlined" aria-hidden="true">location_on</span><%= p.places.slice(0, 2).join(', ') %><%= p.places.length > 2 ? ` +${p.places.length - 2}` : '' %></span><% if (p.courseCode) { %><span class="pcard__code"><%= p.courseCode %></span><% } %></p>
                </div>
              </a>
            </li>
          <% }) %>
        </ul>
        <p class="latest__empty" data-latest-empty hidden>Chưa có món mới nào hẹn ở cơ sở này. <a href="/products">Xem tất cả món đang bán</a></p>
      </div>
    </section>
    <% } %>

    <!-- 4 · Cách hoạt động: ba bước, không ra khỏi trường -->
    <section class="how" aria-labelledby="how-title">
      <div class="how__inner">
        <h2 id="how-title" class="how__title">Mua bán trong ba bước, không cần ra khỏi trường.</h2>
        <ol class="how__steps">
          <li class="how__step">
            <span class="how__num tabular">01</span>
            <span class="material-symbols-outlined how__icon" aria-hidden="true">travel_explore</span>
            <h3>Tìm hoặc đăng</h3>
            <p>Lọc theo mã môn, danh mục, cơ sở. Đăng tin chỉ cần ảnh, giá và điểm hẹn.</p>
          </li>
          <li class="how__step">
            <span class="how__num tabular">02</span>
            <span class="material-symbols-outlined how__icon" aria-hidden="true">chat</span>
            <h3>Nhắn và chốt giá</h3>
            <p>Chat ngay trên Chợ UEH. Email, MSSV và số điện thoại không hiện công khai.</p>
          </li>
          <li class="how__step">
            <span class="how__num tabular">03</span>
            <span class="material-symbols-outlined how__icon" aria-hidden="true">handshake</span>
            <h3>Gặp nhau ở trường</h3>
            <p>Chọn giờ rảnh giữa các tiết và gặp ở cơ sở A, B, N, thư viện hoặc căn tin.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- 5 · Đỉnh: thời khoá biểu. Cuộn kéo kim dọc theo cột trái, món đồ thật bật lên đúng khung giờ -->
    <section class="day" data-sc-act="pin" data-sc-span="4.2" aria-labelledby="day-title" data-day>
      <div data-sc-stage class="day__stage">
        <div class="day__head">
          <div>
            <p class="day__eyebrow">Một ngày học có bốn lúc rảnh.</p>
            <h2 id="day-title" class="day__title">Nhận món nào, lúc nào, ở đâu?</h2>
          </div>
          <div class="day__clock">
            <span class="day__clock-label">Khung giờ đang xem</span>
            <span class="day__time tabular" data-day-time aria-hidden="true">07:00</span>
            <span class="day__now" data-day-now>Đầu giờ sáng</span>
          </div>
        </div>
        <ol class="day__rows" data-day-rows>
          <span class="day__rail" aria-hidden="true"><span class="day__fill" data-day-fill></span></span>
          <span class="day__hand" data-day-hand aria-hidden="true"></span>
          <% timetable.forEach((row) => { %>
            <li class="day__row" data-clock="<%= hhmm(row.clock) %>" data-slot="<%= row.slot %>">
              <button type="button" class="day__slot" data-day-go>
                <span class="day__slot-time tabular"><%= hhmm(row.clock) %></span>
                <span class="day__slot-name"><%= row.slot %></span>
              </button>
              <ul class="day__items">
                <% row.items.forEach((p, i) => { %>
                  <li style="--i:<%= i %>">
                    <a href="/product/<%= p._id %>" class="chip">
                      <img src="<%= img(p.images[0], 120) %>" alt="" width="56" height="56" loading="lazy" />
                      <span class="chip__text">
                        <span class="chip__name"><%= p.title %></span>
                        <span class="chip__meta"><strong class="tabular"><%= fmt(p.price) %></strong> · <%= p.places.slice(0, 2).join(', ') %></span>
                      </span>
                    </a>
                  </li>
                <% }) %>
                <% if (row.more) { %><li style="--i:3"><a class="chip chip--more" href="/products">+<%= row.more %> món</a></li><% } %>
                <% if (!row.items.length) { %><li class="chip chip--empty">Chưa có món nào hẹn giờ này</li><% } %>
              </ul>
            </li>
          <% }) %>
        </ol>
      </div>
    </section>

    <!-- 6 · Bảng Đang cần: người khác đang cần đúng món bạn có -->
    <section class="wanted" data-sc-act="flow" aria-labelledby="wanted-title">
      <div class="wanted__inner">
        <div class="wanted__head" data-sc-in>
          <h2 id="wanted-title" class="wanted__title">Có người đang cần đúng món bạn có.</h2>
          <p>Bảng "Đang cần" để sinh viên đăng thứ mình tìm. Nếu bạn có, nhắn cho họ.</p>
          <a class="btn btn--ghost" href="/products?listingType=wanted">Xem bảng Đang cần</a>
        </div>
        <div class="wanted__board<%= wanted.length % 2 ? '' : ' is-even' %>" data-sc-reveal="up" data-sc-reveal-at="0.12 0.5">
          <% wanted.forEach((p, i) => { %>
            <a class="slip slip--<%= i % 4 %>" href="/product/<%= p._id %>">
              <span class="slip__kicker"><%= urgency[p.urgency] || 'Đang cần' %><%= p.courseCode ? ` · ${p.courseCode}` : '' %></span>
              <span class="slip__name"><%= p.title %></span>
              <span class="slip__budget tabular"><%= budget(p) %></span>
              <span class="slip__hint">Tôi có món này <span aria-hidden="true">→</span></span>
            </a>
          <% }) %>
          <a class="slip slip--add" href="/post-ad?type=wanted">
            <span class="material-symbols-outlined slip__plus" aria-hidden="true">add</span>
            <span class="slip__name">Bạn đang tìm giáo trình hay đồ gì?</span>
            <span class="slip__budget">Đăng lên bảng Đang cần, người có món sẽ nhắn bạn.</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 7 · Quyết: một nhãn trống chờ món của bạn -->
    <section class="close" data-sc-act="flow" aria-labelledby="close-title">
      <div class="close__inner">
        <div class="tag tag--blank" data-sc-in>
          <h2 id="close-title" class="tag__name">Món tiếp theo trên kệ: của bạn.</h2>
          <span class="tag__row">Tình trạng: <i class="blank"></i></span>
          <span class="tag__row">Giá: <i class="blank"></i></span>
          <span class="tag__row">Hẹn: <i class="blank"></i></span>
          <a class="btn btn--accent tag__cta" href="/post-ad">Đăng tin <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
        </div>
        <ul class="close__facts">
          <li><span class="tabular">0đ</span>phí trung gian, tiền trao tay</li>
          <li><span>3 cơ sở</span>A · B · N, cùng thư viện và căn tin</li>
          <li><span>100%</span>tài khoản đăng ký bằng email UEH</li>
          <% if (stats.activeCount >= 10) { %><li><span class="tabular"><%= stats.activeCount %></span>món đang chờ chủ mới</li>
          <% } else { %><li><span>4</span>khung giờ hẹn theo tiết học</li><% } %>
        </ul>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <div id="toast-container" class="toast-container"></div>

  <script src="/js/app.js"></script>
  <script src="/vendor/scrollcraft.js"></script>
  <script src="/js/home.js"></script>
</body>
</html>
