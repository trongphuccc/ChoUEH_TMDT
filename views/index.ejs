<%
  const fmt = (n) => (n === undefined || n === null) ? 'Thoả thuận' : new Intl.NumberFormat('vi-VN').format(n) + 'đ';
  const budget = (p) => p.budgetMin && p.budgetMax ? `${fmt(p.budgetMin)} đến ${fmt(p.budgetMax)}`
    : p.budgetMax ? `Tối đa ${fmt(p.budgetMax)}` : p.budgetMin ? `Từ ${fmt(p.budgetMin)}` : 'Linh hoạt';
  const cond = (c) => c === 'new' ? 'Còn mới' : 'Đã dùng';
  // Ask Cloudinary for a right-sized copy instead of the original upload.
  const img = (url, w) => String(url || '').includes('/upload/') ? url.replace('/upload/', `/upload/w_${w},c_limit,f_auto,q_auto/`) : url;
  const places = (p) => [...new Set((p.meetingPoints && p.meetingPoints.length ? p.meetingPoints : [p.location]).map(shortPlace))];
  const urgency = { high: 'Cần gấp', medium: 'Trong tuần này', low: 'Không vội' };
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Chợ UEH · Đồ cũ của khoá trên, giá của sinh viên</title>
  <meta name="description" content="Sàn mua bán đồ cũ nội bộ cho sinh viên UEH. Giáo trình, điện tử, đồ dùng. Hẹn nhận đồ ngay tại cơ sở A, B, N." />
  <meta property="og:title" content="Chợ UEH · Đồ cũ của khoá trên, giá của sinh viên" />
  <meta property="og:description" content="Mua bán đồ cũ nội bộ sinh viên UEH. Hẹn nhận đồ ngay trong khuôn viên trường." />
  <% if (hero) { %><meta property="og:image" content="<%= img(hero.images[0], 1200) %>" /><% } %>
  <meta name="theme-color" content="#f3f5f1" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/vendor/scrollcraft.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <link rel="stylesheet" href="/css/home.css" />
  <% if (hero) { %><link rel="preload" as="image" href="<%= img(hero.images[0], 900) %>" /><% } %>
</head>
<body class="home">
  <%- include('partials/navbar') %>

  <main id="main">

    <!-- 1 · Nhận ra: món đồ thật đầu tiên, nhiều lớp chuyển động khác nhau -->
    <section class="hero" data-sc-act="flow">
      <div class="hero__copy">
        <h1 class="hero__title">Đồ cũ của khoá trên, <em>giá của sinh viên.</em></h1>
        <p class="hero__sub">Sàn mua bán nội bộ chỉ dành cho sinh viên UEH. Hẹn nhận đồ ngay tại cơ sở A, B hoặc N.</p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href="/products">Xem đồ đang bán</a>
          <a class="btn btn--ghost" href="/post-ad">Đăng tin</a>
        </div>
      </div>

      <div class="hero__scene" aria-hidden="<%= hero ? 'false' : 'true' %>">
        <div class="hero__plane hero__plane--back" data-sc-parallax="1.6"></div>
        <% heroSide.forEach((p, i) => { %>
          <a href="/product/<%= p._id %>" class="hero__side hero__side--<%= i %>" data-sc-parallax="<%= i ? '1.1' : '0.8' %>" tabindex="-1">
            <img src="<%= img(p.images[0], 400) %>" alt="" width="400" height="400" loading="eager" />
          </a>
        <% }) %>
        <% if (hero) { %>
          <a href="/product/<%= hero._id %>" class="hero__object" data-sc-parallax="0.2">
            <img src="<%= img(hero.images[0], 900) %>" alt="<%= hero.title %>" width="900" height="900" fetchpriority="high" />
          </a>
          <div class="hero__front" data-sc-parallax="-0.9">
            <a href="/product/<%= hero._id %>" class="tag hero__tag">
              <span class="tag__name"><%= hero.title %></span>
              <span class="tag__row"><%= cond(hero.condition) %> · <strong class="tabular"><%= fmt(hero.price) %></strong></span>
              <span class="tag__row">Hẹn: <%= places(hero).slice(0, 2).join(', ') %></span>
            </a>
          </div>
        <% } %>
        <img class="hero__zeen" src="/images/zeen-mascot.png" alt="" width="840" height="884" data-sc-parallax="-1.4" />
      </div>
    </section>

    <!-- 2 · Định hướng: mục lục các món, số đếm thật -->
    <section class="index" data-sc-act="flow" aria-labelledby="index-title">
      <div class="index__inner">
        <h2 id="index-title" class="index__title">Bạn đang tìm gì?</h2>
        <form class="index__search" action="/products" method="get" role="search">
          <label class="sr-only" for="home-search">Tìm theo tên hoặc mã môn</label>
          <span class="material-symbols-outlined" aria-hidden="true">search</span>
          <input id="home-search" name="search" type="search" placeholder="Tên món, mã môn (VD: KTVM)…" />
          <button type="submit" class="btn btn--primary">Tìm</button>
        </form>
        <ul class="index__list" data-sc-stagger="50" data-sc-in>
          <% categories.forEach((c) => { %>
            <li>
              <a href="/products?category=<%= c.slug %>" class="cat">
                <span class="material-symbols-outlined cat__icon" aria-hidden="true"><%= c.icon %></span>
                <span class="cat__label"><%= c.label %></span>
                <span class="cat__count tabular"><%= c.count %> món</span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>

    <% if (rail.length) { %>
    <!-- 3 · Thèm: các món trôi ngang, cùng một kiểu nhãn -->
    <section class="shelf" data-sc-act="pan" data-sc-span="<%= Math.max(2.4, rail.length * 0.3 + 0.8).toFixed(2) %>" aria-labelledby="shelf-title">
      <div data-sc-stage class="shelf__stage">
        <div class="shelf__rail" data-sc-pan="0.04">
          <div class="shelf__lead">
            <h2 id="shelf-title" class="shelf__title">Mới lên kệ</h2>
            <p>Đăng bởi sinh viên UEH, ảnh thật, giá thật.</p>
          </div>
          <% rail.forEach((p, i) => { %>
            <article class="item" style="--i:<%= i %>">
              <a href="/product/<%= p._id %>" class="item__link">
                <div class="item__photo" data-sc-tilt="5">
                  <img src="<%= img(p.images[0], 600) %>" alt="<%= p.title %>" width="600" height="600" loading="lazy" />
                  <% if (p.transactionStatus === 'negotiating' || p.transactionStatus === 'deposited') { %>
                    <span class="item__flag"><%= p.transactionStatus === 'deposited' ? 'Đã cọc' : 'Đang thương lượng' %></span>
                  <% } %>
                </div>
                <div class="label">
                  <h3 class="label__name"><%= p.title %></h3>
                  <p class="label__row"><span><%= cond(p.condition) %></span><strong class="tabular"><%= fmt(p.price) %></strong></p>
                  <p class="label__row label__row--soft">Hẹn: <%= places(p).slice(0, 2).join(', ') %><%= places(p).length > 2 ? ` +${places(p).length - 2}` : '' %></p>
                </div>
              </a>
            </article>
          <% }) %>
          <a class="shelf__end" href="/products">
            <span class="shelf__end-num tabular"><%= stats.activeCount %></span>
            <span>món đang bán. Xem tất cả <span aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>
    </section>
    <% } %>

    <!-- 4 · Lặng: khoảng trống có chủ ý trước đỉnh -->
    <section class="quiet" data-sc-act="flow">
      <p class="quiet__line" data-sc-in>Một ngày học có bốn lúc rảnh.</p>
    </section>

    <!-- 5 · Đỉnh: đồng hồ tiết học. Cuộn kéo kim qua cả ngày, món đồ thật bật lên đúng giờ hẹn -->
    <section class="day" data-sc-act="pin" data-sc-span="4.2" aria-labelledby="day-title" data-day>
      <div data-sc-stage class="day__stage">
        <div class="day__head">
          <h2 id="day-title" class="day__title">Nhận món nào, lúc nào, ở đâu?</h2>
          <div class="day__clock" aria-hidden="true">
            <span class="day__time tabular" data-day-time>07:00</span>
            <span class="day__now" data-day-now>Đầu giờ sáng</span>
          </div>
        </div>
        <ol class="day__rows" data-day-rows>
          <span class="day__hand" data-day-hand aria-hidden="true"></span>
          <% timetable.forEach((row) => { %>
            <li class="day__row" data-clock="<%= row.clock %>" data-slot="<%= row.slot %>">
              <div class="day__slot">
                <span class="day__slot-time tabular"><%= row.clock %></span>
                <span class="day__slot-name"><%= row.slot %></span>
              </div>
              <ul class="day__items">
                <% row.items.forEach((p, i) => { %>
                  <li style="--i:<%= i %>">
                    <a href="/product/<%= p._id %>" class="chip">
                      <img src="<%= img(p.images[0], 120) %>" alt="" width="56" height="56" loading="lazy" />
                      <span class="chip__text">
                        <span class="chip__name"><%= p.title %></span>
                        <span class="chip__meta"><strong class="tabular"><%= fmt(p.price) %></strong> · <%= p.places.slice(0, 2).join(', ') %></span>
                      </span>
                    </a>
                  </li>
                <% }) %>
                <% if (row.more) { %><li style="--i:3"><a class="chip chip--more" href="/products">+<%= row.more %> món</a></li><% } %>
                <% if (!row.items.length) { %><li class="chip chip--empty">Chưa có món nào hẹn giờ này</li><% } %>
              </ul>
            </li>
          <% }) %>
        </ol>
      </div>
    </section>

    <% if (wanted.length) { %>
    <!-- 6 · Đồng cảm: người khác đang cần đúng món bạn có -->
    <section class="wanted" data-sc-act="flow" aria-labelledby="wanted-title">
      <div class="wanted__inner">
        <div class="wanted__head" data-sc-in>
          <h2 id="wanted-title" class="wanted__title">Có người đang cần đúng món bạn có.</h2>
          <p>Bảng "Đang cần" để sinh viên đăng thứ mình tìm. Nếu bạn có, nhắn cho họ.</p>
          <a class="btn btn--ghost" href="/products?listingType=wanted">Xem bảng Đang cần</a>
        </div>
        <div class="wanted__board" data-sc-reveal="up" data-sc-reveal-at="0.12 0.5">
          <% wanted.forEach((p, i) => { %>
            <a class="slip slip--<%= i % 4 %>" href="/product/<%= p._id %>">
              <span class="slip__kicker"><%= urgency[p.urgency] || 'Đang cần' %><%= p.courseCode ? ` · ${p.courseCode}` : '' %></span>
              <span class="slip__name"><%= p.title %></span>
              <span class="slip__budget tabular"><%= budget(p) %></span>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <!-- 7 · Quyết: một nhãn trống chờ món của bạn -->
    <section class="close" data-sc-act="flow" aria-labelledby="close-title">
      <div class="close__inner">
        <div class="tag tag--blank" data-sc-in>
          <h2 id="close-title" class="tag__name">Món tiếp theo trên kệ: của bạn.</h2>
          <span class="tag__row">Tình trạng: <i class="blank"></i></span>
          <span class="tag__row">Giá: <i class="blank"></i></span>
          <span class="tag__row">Hẹn: <i class="blank"></i></span>
          <a class="btn btn--primary tag__cta" href="/post-ad">Đăng tin</a>
        </div>
        <ul class="close__facts" data-sc-stagger="80" data-sc-in>
          <% if (stats.activeCount) { %><li><span class="tabular" data-sc-count="0 <%= stats.activeCount %>"><%= stats.activeCount %></span> món đang bán</li><% } %>
          <% if (stats.soldCount) { %><li><span class="tabular" data-sc-count="0 <%= stats.soldCount %>"><%= stats.soldCount %></span> món đã có chủ mới</li><% } %>
          <% if (stats.userCount) { %><li><span class="tabular" data-sc-count="0 <%= stats.userCount %>"><%= stats.userCount %></span> sinh viên đã tham gia</li><% } %>
        </ul>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <div id="toast-container" class="toast-container"></div>

  <script src="/js/app.js"></script>
  <script src="/vendor/scrollcraft.js"></script>
  <script src="/js/home.js"></script>
</body>
</html>
