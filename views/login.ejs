<!DOCTYPE html>
<html lang="vi">
<head>
  <title>Đăng Nhập | Chợ UEH</title>
  <%- include('partials/head') %>
</head>
<body class="bg-background text-on-surface">
<main id="main" class="auth min-h-screen grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
  <%- include('partials/auth-panel') %>

  <!-- RIGHT PANEL -->
  <section class="flex flex-col justify-center px-6 py-12 md:p-16">
    <a href="/" class="cho-ueh-logo md:hidden mb-10 self-center"><div class="logo-emblem"><span class="material-symbols-outlined text-white">school</span></div><div class="logo-wordmark"><span class="logo-cho">Chợ</span><span class="logo-ueh-text">UEH<span class="accent-dot">.</span></span></div></a>
    <div class="max-w-md mx-auto w-full">
      <div class="mb-10">
        <h1 class="font-headline text-4xl font-extrabold text-on-surface tracking-tight mb-2">Chào mừng trở lại.</h1>
        <p class="text-on-surface-variant font-medium">Chưa có tài khoản? <a class="text-tertiary font-semibold hover:underline" href="/register">Đăng ký miễn phí</a></p>
      </div>
      <div class="mb-8 p-4 bg-primary-container/10 rounded-xl border-l-4 border-primary-container flex items-start gap-3">
        <span class="material-symbols-outlined text-primary-container" style="font-variation-settings: 'FILL' 1;">info</span>
        <p class="text-sm font-semibold text-primary-container leading-snug">Sử dụng email UEH hoặc MSSV để đăng nhập.</p>
      </div>

      <form id="login-form" class="space-y-6">
        <div>
          <label class="block text-sm font-semibold text-on-surface-variant mb-2" for="email">Email UEH hoặc MSSV</label>
          <div class="relative group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">alternate_email</span>
            <input class="w-full pl-12 pr-4 py-3.5 bg-white rounded-xl transition-all outline-none font-medium placeholder:text-outline/60" id="email" placeholder="2224102... hoặc email@student.ueh.edu.vn" type="text" required/>
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-on-surface-variant mb-2" for="password">Mật khẩu</label>
          <div class="relative group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">lock</span>
            <input class="w-full pl-12 pr-12 py-3.5 bg-white rounded-xl transition-all outline-none font-medium placeholder:text-outline/60" id="password" placeholder="••••••••" type="password" required/>
          </div>
        </div>
        <div id="login-error" class="hidden p-3 bg-red-50 text-red-700 rounded-lg text-sm font-medium"></div>
        <button class="btn btn--primary w-full !min-h-[52px] text-base" type="submit" id="login-btn">
          Đăng Nhập
          <span class="material-symbols-outlined">arrow_forward</span>
        </button>
      </form>
      <div class="mt-12 text-center">
        <a href="/" class="text-sm text-on-surface-variant hover:text-primary">← Về trang chủ</a>
      </div>
    </div>
  </section>
</main>

<div id="toast-container" class="toast-container"></div>
<script src="/js/app.js"></script>
<script src="/js/auth.js"></script>
</body>
</html>
