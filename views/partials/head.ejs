<%# Shared <head> for every page: one palette, one type pair, one Tailwind config. %>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#f3f5f1" />
