<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script src="https://cdn.tailwindcss.com?plugins=forms"></script>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
<link href="/css/custom.css" rel="stylesheet" />
<style>
  body { background: #f3f5f1; color: #10282b; }
  .doc { max-width: 44rem; margin: 0 auto; padding: 7rem 1.25rem 5rem; }
  .doc h1 { font-size: clamp(2rem, 1.5rem + 2vw, 3rem); font-weight: 800; line-height: 1.05; margin-bottom: .5rem; }
  .doc h2 { font-size: 1.3rem; font-weight: 700; margin: 2.25rem 0 .6rem; }
