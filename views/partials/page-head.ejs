  .doc ul { list-style: disc; padding-left: 1.25rem; display: grid; gap: .35rem; }
  .doc .updated { color: #4a6164; font-size: .9rem; }
  .doc a { color: #005f69; text-decoration: underline; text-underline-offset: 3px; }
