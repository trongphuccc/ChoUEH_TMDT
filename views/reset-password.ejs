<!DOCTYPE html>
<html lang="vi">
<head>
  <title>Đặt mật khẩu mới · Chợ UEH</title>
  <meta name="referrer" content="no-referrer" />
  <%- include('partials/head') %>
</head>
<body class="bg-background text-on-surface">
<main id="main" class="auth min-h-screen grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
  <%- include('partials/auth-panel', { panelTitle: 'Mật khẩu mới, vẫn khu chợ cũ.', zeenTip: 'Chọn mật khẩu khác với mật khẩu email UEH cho an toàn nhé!' }) %>

  <section class="flex flex-col justify-center px-6 py-12 md:p-16">
    <a href="/" class="cho-ueh-logo md:hidden mb-10 self-center"><div class="logo-emblem"><span class="material-symbols-outlined text-white">school</span></div><div class="logo-wordmark"><span class="logo-cho">Chợ</span><span class="logo-ueh-text">UEH<span class="accent-dot">.</span></span></div></a>
    <div class="max-w-md mx-auto w-full">
      <div class="mb-8">
        <h1 class="font-headline text-4xl font-extrabold text-on-surface tracking-tight mb-2">Đặt mật khẩu mới</h1>
        <p class="text-on-surface-variant">Sau khi lưu, các thiết bị đang đăng nhập bằng mật khẩu cũ sẽ tự đăng xuất.</p>
      </div>

      <form id="reset-form" class="space-y-6" novalidate>
        <input type="text" name="username" autocomplete="username" hidden aria-hidden="true" tabindex="-1" />
        <div>
          <label class="block text-sm font-semibold text-on-surface-variant mb-2" for="reset-password">Mật khẩu mới</label>
          <div class="relative">
            <input id="reset-password" name="new-password" class="w-full px-4 pr-12 py-3.5 rounded-xl outline-none font-medium" placeholder="Ít nhất 6 ký tự" type="password" autocomplete="new-password" minlength="6" required/>
            <button type="button" class="pw-toggle" data-toggle-pw aria-label="Hiện mật khẩu" aria-pressed="false"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button>
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-on-surface-variant mb-2" for="reset-confirm">Nhập lại mật khẩu mới</label>
          <div class="relative">
            <input id="reset-confirm" name="confirm-password" class="w-full px-4 pr-12 py-3.5 rounded-xl outline-none font-medium" placeholder="Nhập lại mật khẩu" type="password" autocomplete="new-password" required/>
            <button type="button" class="pw-toggle" data-toggle-pw aria-label="Hiện mật khẩu" aria-pressed="false"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button>
          </div>
        </div>
        <div id="reset-error" class="hidden p-3 bg-red-50 text-red-700 rounded-lg text-sm font-medium" role="alert"></div>
        <button class="btn btn--primary w-full !min-h-[52px] text-base" type="submit" id="reset-btn">
          Lưu mật khẩu mới <span class="material-symbols-outlined" aria-hidden="true">check</span>
        </button>
      </form>

      <div class="mt-10 text-sm">
        <a href="/forgot-password" class="text-on-surface-variant hover:text-primary">Link hết hạn? Yêu cầu link mới</a>
      </div>
    </div>
  </section>
</main>

<div id="toast-container" class="toast-container"></div>
<script src="/js/app.js"></script>
<script src="/js/auth.js"></script>
</body>
</html>
